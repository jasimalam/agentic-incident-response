set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.0.1.2/30
set / network-instance default interface ethernet-1/1.0
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.0.2.1/30
set / network-instance default interface ethernet-1/2.0
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 10.0.3.1/30
set / network-instance default interface ethernet-1/3.0
set / network-instance default next-hop-groups group service-next-hop nexthop 1 ip-address 10.0.3.2
set / network-instance default static-routes route 198.51.100.0/24 next-hop-group service-next-hop
set / network-instance default protocols bgp autonomous-system 65001
set / network-instance default protocols bgp router-id 10.0.1.2
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp ebgp-default-policy import-reject-all false
set / network-instance default protocols bgp group upstream admin-state enable
set / network-instance default protocols bgp neighbor 10.0.1.1 peer-group upstream
set / network-instance default protocols bgp neighbor 10.0.1.1 peer-as 65000
set / network-instance default protocols bgp neighbor 10.0.1.1 admin-state enable
set / network-instance default protocols bgp group srl-b admin-state enable
set / network-instance default protocols bgp neighbor 10.0.2.2 peer-group srl-b
set / network-instance default protocols bgp neighbor 10.0.2.2 peer-as 65002
set / network-instance default protocols bgp neighbor 10.0.2.2 admin-state enable
set / network-instance default protocols bgp group srl-b import-policy ["hijack-policy"]
set / network-instance default protocols bgp group upstream export-policy ["hijack-policy"]
set / routing-policy prefix-set hijack-prefix prefix 198.51.100.128/25 mask-length-range 25..25
set / routing-policy policy hijack-policy statement 10 match prefix-set hijack-prefix
set / routing-policy policy hijack-policy statement 10 action policy-result accept
set / routing-policy policy hijack-policy default-action policy-result reject
